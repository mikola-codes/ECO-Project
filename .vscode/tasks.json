{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build hello.cpp",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-o",
                "${workspaceFolder}/hello.exe",
                "${workspaceFolder}/hello.cpp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compile hello.cpp with debug symbols"
        }
    ]
}